# Copy to .env (next to hook.py; it is gitignored) and fill in only what you use.
# Spook works fully offline with none of these set.

# Sentry Agent Tracing: traces every check and Gemma's explanation (item names, scores, timings, tokens; never commands).
# pip install sentry-sdk
SPOOK_SENTRY_DSN=

# Backboard: compare open-weight models as the explainer (python compare_models.py; sends only the demo cases).
BACKBOARD_API_KEY=

# ElevenLabs: narration for the demo video only (../narration/narrate.py sends fixed script lines, nothing else).
ELEVENLABS_API_KEY=

# MongoDB Atlas: shared Book of the Dead for a team (package names, reasons, anonymous reporter ids; never commands or code).
# pip install pymongo
SPOOK_MONGODB_URI=
